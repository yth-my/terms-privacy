rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /policies/{policyId} {
      // Anyone can read public policies (for live public policy URLs)
      allow read: if resource.data.isPublic == true || (request.auth != null && resource.data.userId == request.auth.uid);
      // Allow creation of public policies or authenticated user policies
      allow create: if request.resource.data.isPublic == true || (request.auth != null && request.resource.data.userId == request.auth.uid);
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
